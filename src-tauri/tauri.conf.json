{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "uragami-todo",
  "version": "0.1.0",
  "identifier": "co.obentoba.uragami-todo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "uragami-todo",
        "width": 480,
        "height": 760,
        "minWidth": 360,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ]
  }
}
